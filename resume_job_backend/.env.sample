# Backend environment variables (copy to .env and fill values)

# Database: single URL is preferred. If not set, backend will attempt to build from individual vars.
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/postgres
# Or provide individual parts (used only if POSTGRES_URL is unset)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# CORS: comma-separated list; localhost:3000 is added automatically
CORS_ORIGINS=http://localhost:3000

# Supabase configuration
SUPABASE_URL=
# JWT secret used to verify Authorization Bearer tokens from Supabase. If empty, anonymous is allowed (dev only).
SUPABASE_JWT_SECRET=
# Optional service role key if using storage or admin features
SUPABASE_SERVICE_ROLE_KEY=

# File storage bucket name (placeholder for future integration)
FILE_STORAGE=resumes

# Backend port (for reference; actual runner may supply)
BACKEND_PORT=3001
