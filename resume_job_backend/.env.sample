# Backend service configuration for Resume Match & Improve API

# Port the FastAPI backend listens on (default is 3001)
BACKEND_PORT=3001

# Comma-separated list of origins allowed for CORS.
# Ensure your frontend origin is included. Defaults to include http://localhost:3000 in code.
# Example: http://localhost:3000,https://your-domain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL connection configuration
# Preferred: a single DSN URL. Example below assumes local Postgres forwarded on 5001
POSTGRES_URL=postgresql://appuser:dbuser123@localhost:5001/myapp

# Fallbacks if POSTGRES_URL is not provided (all required to build DSN)
POSTGRES_HOST=localhost
POSTGRES_PORT=5001
POSTGRES_USER=appuser
POSTGRES_PASSWORD=dbuser123
POSTGRES_DB=myapp

# Supabase configuration (optional for local/dev without auth)
# Public Supabase URL (e.g., https://<project>.supabase.co)
SUPABASE_URL=
# JWT secret from Supabase project settings -> API -> JWT Settings
SUPABASE_JWT_SECRET=
# Service role key from Supabase project settings -> API -> Service role
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket name used for resume files/uploads
SUPABASE_BUCKET_RESUMES=resumes
