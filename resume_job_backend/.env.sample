# Resume Match & Improve - Backend (.env.sample)
# Copy this file to .env and fill in values as needed.
#
# Notes:
# - Database: Prefer POSTGRES_URL for a single connection string. If not set, the app will build a DSN from individual POSTGRES_* parts.
# - CORS: Provide a comma-separated list of frontend origins. Defaults include http://localhost:3000 in code.
# - Supabase (optional): If SUPABASE_JWT_SECRET is not set, the API will allow anonymous requests for development. For auth-enabled flows,
#   set SUPABASE_URL and SUPABASE_JWT_SECRET (and optionally SUPABASE_SERVICE_ROLE_KEY) and ensure the frontend supplies a valid JWT.
# - Ports: BACKEND_PORT defaults to 3001 if not provided.

# -----------------------------
# Database connection (PostgreSQL)
# -----------------------------
# Prefer a single connection string (set this if you have it):
POSTGRES_URL=postgresql://appuser:dbuser123@localhost:5001/myapp

# Or provide parts (used only if POSTGRES_URL is not set):
POSTGRES_HOST=localhost
POSTGRES_PORT=5001
POSTGRES_DB=myapp
POSTGRES_USER=appuser
POSTGRES_PASSWORD=dbuser123

# -----------------------------
# Backend
# -----------------------------
# API server port (default: 3001)
BACKEND_PORT=3001

# CORS allowed origins (comma-separated). The app also allows http://localhost:3000 by default.
CORS_ORIGINS=http://localhost:3000

# -----------------------------
# Supabase (optional)
# -----------------------------
# Base URL to your Supabase project (optional but recommended if using auth)
SUPABASE_URL=https://your-project-id.supabase.co

# JWT secret (from Supabase settings). If not set, API allows anonymous access for development.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Service role key (optional, required only if backend needs admin operations against Supabase)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: bucket name used for storing resumes if integrating with Supabase Storage
SUPABASE_BUCKET_RESUMES=resumes
